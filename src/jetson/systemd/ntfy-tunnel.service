[Unit]
Description=cloudflared tunnel publishing ntfy (ntfy.example.com)
Documentation=file://https://github.com/ajv009/nano-power-sentinel/DASHBOARD.md
After=network-online.target ntfy.service
Wants=network-online.target

[Service]
Type=simple
User=jetson
ExecStart=/usr/bin/cloudflared --no-autoupdate --config /home/jetson/.cloudflared/ntfy.yml tunnel run ntfy-nano
Restart=always
RestartSec=10
# Same reasoning as every other unit in this chain: a service that exists to
# still be working when things are going wrong must never stop retrying.
# systemd's default gives up after 5 starts in 10s.
StartLimitIntervalSec=0

# This only carries short notification traffic and shares a 2-core box with
# ups-sentinel, which is the safety-critical process here.
Nice=10
CPUWeight=20

[Install]
WantedBy=multi-user.target

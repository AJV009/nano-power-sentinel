[Unit]
Description=Turn the Ethernet LEDs off (bright and distracting at night)
Documentation=file://https://github.com/ajv009/nano-power-sentinel/NOTES.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Must run after r8168 has brought eth0 up, or the driver's own init
# overwrites LEDSEL again.
ExecStart=/usr/local/sbin/eth-leds off
# Leaving the LEDs off is cosmetic; never let a failure here block boot or
# take anything else down with it.
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target

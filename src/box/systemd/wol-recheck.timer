[Unit]
Description=Periodically re-arm Wake-on-LAN
Documentation=file://https://github.com/ajv009/nano-power-sentinel/DASHBOARD.md

[Timer]
# r8169 drops the WoL flag on reboot, and nothing else notices if arming ever
# fails. Without this, a silent disarm is only discovered during an outage --
# at which point the box cannot be woken and the whole recovery path is dead.
OnBootSec=3min
OnUnitActiveSec=15min
AccuracySec=30s

[Install]
WantedBy=timers.target

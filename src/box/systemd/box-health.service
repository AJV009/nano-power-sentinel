[Unit]
Description=Collect privileged box health for the UPS dashboard
Documentation=file://https://github.com/ajv009/nano-power-sentinel/DASHBOARD.md

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/box-health
# Runs as root because ethtool's WoL flag, NVMe SMART and efibootmgr all
# require it. box-agent stays unprivileged and merely reads the output.

[Unit]
Description=Re-arm Wake-on-LAN (guards against silent disarm)
Documentation=file://https://github.com/ajv009/nano-power-sentinel/DASHBOARD.md

[Service]
Type=oneshot
# wol-arm is Type=oneshot RemainAfterExit=yes, so `start` on an already-active
# unit is a no-op. Restart re-runs its ExecStart, which is safe to repeat:
# its /proc/acpi/wakeup line greps before writing, because that file TOGGLES
# on write rather than being set to a value.
ExecStart=/usr/bin/systemctl restart wol-arm.service

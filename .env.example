# Power Sentinel -- site configuration.
#
# Copy to .env and fill in for your own hardware:
#     cp .env.example .env
#
# .env is gitignored. Nothing in this file is a password: real credentials
# (NUT, ntfy) live in root-owned files on the machines themselves and are
# never stored in this repo. See docs/SECRETS.md.

# ---------------------------------------------------------------------------
# The two machines
# ---------------------------------------------------------------------------

# The Jetson (or any always-on small Linux box) that holds the UPS USB cable.
# It must be on a SEPARATE UPS from the machine it protects -- that separation
# is the whole point of the design.
JETSON_HOST=jetson-nano
JETSON_IP=10.0.0.10
JETSON_USER=jetson

# The workstation being protected.
BOX_HOST=workstation
BOX_IP=10.0.0.20
BOX_USER=youruser

# The workstation's wired NIC, and its MAC. The MAC is what Wake-on-LAN
# targets, so it must be the interface that stays powered in standby --
# find it with:  ip -br link
BOX_NIC=eth0
BOX_MAC=aa:bb:cc:dd:ee:ff

# Broadcast address for the magic packet. Normally your LAN's broadcast
# address; WoL is layer 2, so it must be the same subnet as the Jetson.
BROADCAST=10.0.0.255

# ---------------------------------------------------------------------------
# Services
# ---------------------------------------------------------------------------

# NUT's name for the UPS, as it appears in /etc/nut/ups.conf.
UPS_NAME=apc

# Where the dashboard listens. Keep it on the loopback or a private
# interface: there is no login screen, so the network IS the auth boundary.
DASH_PORT=8088
DASH_BIND=0.0.0.0

# The telemetry agent on the workstation.
BOX_AGENT_PORT=9009

# ---------------------------------------------------------------------------
# Notifications (optional -- leave NTFY_URL empty to disable)
# ---------------------------------------------------------------------------

# Your ntfy server. Self-hosting it on the Jetson is recommended: during an
# outage the Jetson survives on its own UPS but your internet usually does
# not, and a locally-hosted ntfy can still reach a phone on the house wifi.
NTFY_URL=
NTFY_TOPIC=power-sentinel

# ---------------------------------------------------------------------------
# Remote access (optional)
# ---------------------------------------------------------------------------

# If you front the dashboard with Tailscale Serve, this is only used in docs
# and helper scripts. Service workers -- and therefore the installable PWA --
# require a secure context, so plain http:// over a LAN IP will not install.
DASH_PUBLIC_URL=
